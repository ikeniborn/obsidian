{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LLM Wiki Domain Map",
  "version": "1.0.0",
  "wiki_root": ".wiki",
  "domains": [
    {
      "id": "документация",
      "name": "Obsidian Sync Server",
      "description": "Production-ready self-hosted sync server for Obsidian notes",
      "wiki_dir": ".wiki/документация",
      "source_paths": [
        ".",
        "scripts/",
        "serverpeer/",
        "templates/",
        "docs/"
      ],
      "entity_types": [
        {
          "type": "компонент",
          "description": "Ключевые компоненты системы (CouchDB, Nginx, ServerPeer, coturn и др.)",
          "extraction_cues": ["container", "docker", "service", "nginx", "couchdb", "serverpeer", "coturn", "nostr", "certbot", "ufw", "компонент", "сервис"],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "документация/компоненты"
        },
        {
          "type": "скрипт",
          "description": "Shell-скрипты деплоя и обслуживания системы",
          "extraction_cues": [".sh", "script", "bash", "install.sh", "setup.sh", "deploy.sh", "backup", "скрипт", "функция"],
          "min_mentions_for_page": 1,
          "wiki_subfolder": "документация/скрипты"
        },
        {
          "type": "паттерн",
          "description": "Архитектурные паттерны и подходы (networking, SSL, backup и др.)",
          "extraction_cues": ["pattern", "mode", "shared", "isolated", "network", "ssl", "backup", "паттерн", "подход", "режим"],
          "min_mentions_for_page": 2,
          "wiki_subfolder": "документация/паттерны"
        },
        {
          "type": "конфигурация",
          "description": "Конфигурационные файлы и переменные окружения",
          "extraction_cues": [".env", ".ini", ".conf", ".yml", "template", "config", "конфигурация", "настройка", "переменная"],
          "min_mentions_for_page": 1,
          "wiki_subfolder": "документация/конфигурации"
        }
      ],
      "tags": ["infrastructure", "docker", "obsidian", "sync"],
      "language_notes": "Русский для wiki-страниц, английский для технических терминов"
    }
  ],
  "cross_domain_rules": {
    "description": "Правила для сущностей, встречающихся в нескольких доменах",
    "rules": []
  },
  "special_source_types": {},
  "source_types": {
    ".md": {
      "reader": "markdown",
      "extract": ["narrative", "frontmatter", "code_blocks", "headings"],
      "rules_file": "rules/readers/markdown.md"
    },
    ".py": {
      "reader": "python",
      "extract": ["public_api", "docstrings", "types", "imports"],
      "rules_file": "rules/readers/python.md"
    },
    ".ts": {
      "reader": "typescript",
      "extract": ["public_api", "docstrings", "types", "imports"],
      "rules_file": "rules/readers/typescript.md"
    },
    ".tsx": {
      "reader": "typescript",
      "extract": ["public_api", "docstrings", "types", "imports"],
      "rules_file": "rules/readers/typescript.md"
    },
    ".js": {
      "reader": "javascript",
      "extract": ["public_api", "docstrings", "imports"],
      "rules_file": "rules/readers/javascript.md"
    },
    ".mjs": {
      "reader": "javascript",
      "extract": ["public_api", "docstrings", "imports"],
      "rules_file": "rules/readers/javascript.md"
    },
    ".sh": {
      "reader": "bash",
      "extract": ["functions", "flags", "exports", "comments"],
      "rules_file": "rules/readers/bash.md"
    }
  }
}
